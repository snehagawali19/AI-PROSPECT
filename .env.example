# =====================================================================
# AI Prospect Discovery — environment configuration
# Copy to .env and replace every YOUR_... / REPLACE_... value.
# Values starting with YOUR_ or REPLACE_ are treated as "not configured".
# =====================================================================

# ---- Required: search + platform APIs ----
# https://serper.dev  (2,500 free queries)
SERPER_API_KEY=YOUR_SERPER_API_KEY_HERE
# Google Cloud Console → enable "YouTube Data API v3" → API key
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# ---- Required: LLM keys (primary + fallback from different vendors) ----
# https://console.anthropic.com
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
# https://aistudio.google.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ---- Required: model IDs (run `python -m scripts.list_models` to see valid IDs for your keys) ----
PRIMARY_PROVIDER=anthropic
# a Claude Haiku-class model ID
PRIMARY_MODEL=REPLACE_WITH_PRIMARY_MODEL_ID
FALLBACK_PROVIDER=gemini
# a Gemini Flash-Lite-class model ID
FALLBACK_MODEL=REPLACE_WITH_FALLBACK_MODEL_ID

# ---- Recommended: pricing in USD per 1M tokens, from the OFFICIAL pricing pages (used for cost reporting) ----
PRIMARY_PRICE_IN_PER_M=0
PRIMARY_PRICE_OUT_PER_M=0
FALLBACK_PRICE_IN_PER_M=0
FALLBACK_PRICE_OUT_PER_M=0

# ---- Optional tuning (defaults shown) ----
LLM_TIMEOUT_S=30
MAX_SERP_CALLS=12
MAX_SITE_FETCHES=8
PLATFORM_TIMEOUT_S=12
MAX_PROSPECTS=25
LLM_BATCH_SIZE=40
CACHE_TTL_S=21600
RATE_LIMIT=10/minute
MAX_PAGE_BYTES=1000000
RESPECT_ROBOTS_TXT=true
